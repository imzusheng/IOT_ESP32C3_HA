## 安全检查和监控

### 安全配置检查

```python
def security_audit():
    """安全配置审计"""
    config = get_config()
    issues = []
    
    # 检查MQTT安全
    if config.get("mqtt", {}).get("port") == 1883:
        issues.append("使用非加密MQTT连接")
    
    if not config.get("mqtt", {}).get("password"):
        issues.append("MQTT密码未设置")
    
    # 检查BLE安全
    if config.get("ble", {}).get("security", {}).get("auth") == "none":
        issues.append("BLE鉴权已禁用")
    
    # 检查WiFi安全
    networks = config.get("wifi", {}).get("networks", [])
    for network in networks:
        if len(network.get("password", "")) < 8:
            issues.append(f"WiFi密码过短: {network.get('ssid')}")
    
    return issues
```

### 安全事件监控

```python
def log_security_event(event_type, details):
    """记录安全事件"""
    from lib.logger import warning, error
    
    security_events = {
        "auth_failure": "认证失败",
        "invalid_token": "无效token",
        "config_tamper": "配置篡改",
        "unauthorized_access": "未授权访问",
    }
    
    event_desc = security_events.get(event_type, "未知安全事件")
    error("安全事件: {} - {}", event_desc, details, module="SECURITY")
```

